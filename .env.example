# Host address to publish. For TVs/Decks on your LAN, set your server's LAN IP or 0.0.0.0.
STREAM_BIND_ADDRESS=127.0.0.1
STREAM_PORT=5057

# The same physical media folder qBittorrent uses. Paths here are on the Docker host.
MEDIA_ROOT=./media
STATE_ROOT=./state
# The path qBittorrent reports for that SAME media folder, inside its container/process.
QBITTORRENT_MEDIA_ROOT=/media

# Set these to the user/group that can read and write the media and state folders.
PUID=1000
PGID=1000

# Your own services, reachable FROM the backend container.
# host.docker.internal refers to the Docker host, whose service ports must be published.
PROWLARR_URL=http://host.docker.internal:9696
PROWLARR_API_KEY=replace-with-your-prowlarr-api-key
QBITTORRENT_URL=http://host.docker.internal:8080
QBITTORRENT_USERNAME=replace-with-your-qbittorrent-user
QBITTORRENT_PASSWORD=replace-with-your-qbittorrent-password
SEERR_URL=http://host.docker.internal:5055

# Optional: "download X" by voice or from a routine (POST /voice/request). Off unless BOTH are set.
# SEERR_API_KEY is in Seerr under Settings > General. VOICE_TOKEN is a long random secret you make up
# (at least 24 characters, for example: openssl rand -hex 24) and put in the routine.
# SEERR_API_KEY=
# VOICE_TOKEN=

# Optional. The qBittorrent category this service owns: it only adopts and deletes torrents in it.
# Set it to the category an earlier install used (for example mcm-stream) to keep managing those torrents.
# STREAM_CATEGORY=cinema-stream
# Optional. Stremio add-ons asked alongside Prowlarr (comma-separated base URLs). The default is two public
# add-ons, which see the title being searched for. Use "none" to ask only your own Prowlarr indexers.
# STREAM_ADDONS=none
# Recommended. Stremio's streaming server (the official stremio/server container on port 11470). Streams then play
# through the same torrent engine as Stremio: it fetches the pieces the player needs first, so starts and seeks are
# quick. Unset, streams fall back to a sequential qBittorrent download.
# STREMIO_SERVER=http://127.0.0.1:11470
